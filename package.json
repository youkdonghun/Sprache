{
  "name": "sprache",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @sprache/api run dev",
    "build:api": "npm --workspace @sprache/api run build",
    "test:api": "npm --workspace @sprache/api run test",
    "lint:api": "npm --workspace @sprache/api run lint",
    "run:client": "node ./tool/run-flutter.mjs run",
    "test:client": "node ./tool/run-flutter.mjs test",
    "check:tatoeba": "node ./tool/verify-tatoeba-packs.mjs",
    "check:google": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\check-google-readiness.ps1",
    "test:live:google:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\run-live-google-e2e.ps1",
    "analyze:client": "node ./tool/run-flutter.mjs analyze",
    "build:windows": "node ./tool/run-flutter.mjs build windows --release",
    "build:android": "node ./tool/run-flutter.mjs build apk --release",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\build-windows-installer.ps1",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\test-windows-installer.ps1",
    "test:windows:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\verify-windows-runtime.ps1",
    "test:windows:ui-e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\test-windows-ui-e2e.ps1",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\verify-release.ps1",
    "verify:release:promote": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\verify-release.ps1 -CleanOldArtifacts",
    "build:real": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\build-real.ps1",
    "build:real:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\build-real.ps1 -Target windows",
    "build:real:android": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\build-real.ps1 -Target android",
    "build:release-gated": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tool\\build-real.ps1 -RequireBrokerReady -RequirePrivacyPolicyUrl -RequireAndroidReleaseSigning -RequireWindowsCodeSigning",
    "test": "npm run test:api && npm run test:client"
  },
  "engines": {
    "node": ">=22"
  }
}
