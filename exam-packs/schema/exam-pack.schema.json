{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprache6.github.io/schema/exam-pack-v1.json",
  "title": "Sprache exam pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "title", "description", "language", "version",
    "revision", "publishedAt", "license", "attribution", "disclaimer",
    "stimuli", "questions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "language": { "const": "en" },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "revision": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "license": { "type": "string", "minLength": 1, "maxLength": 120 },
    "attribution": { "type": "string", "minLength": 1, "maxLength": 500 },
    "disclaimer": { "type": "string", "minLength": 1, "maxLength": 800 },
    "stimuli": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": { "enum": ["none", "photo", "questionResponse", "conversation", "talk", "document"] },
          "title": { "type": "string", "maxLength": 200 },
          "body": { "type": "string", "maxLength": 12000 },
          "audioScript": { "type": "string", "maxLength": 12000 },
          "visualDescription": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "part", "prompt", "choices", "correctIndex", "explanation", "choiceExplanations", "skill", "difficulty"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "part": { "type": "integer", "minimum": 1, "maximum": 7 },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "choices": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
          "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "choiceExplanations": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
          "skill": { "type": "string", "minLength": 1, "maxLength": 120 },
          "difficulty": { "enum": ["foundation", "intermediate", "advanced"] },
          "stimulusId": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    }
  }
}
