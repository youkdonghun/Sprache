# API
DATABASE_URL=postgresql://sprache:sprache@localhost:5432/sprache
GOOGLE_ALLOWED_CLIENT_IDS=replace-with-android-and-desktop-client-ids
USER_KEY_HMAC_SECRET=replace-with-at-least-32-random-bytes
LOG_LEVEL=info
NODE_ENV=development
PORT=3000

# Flutter compile-time values
API_BASE_URL=http://127.0.0.1:3000
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
APP_ENV=development
ENABLE_MOCK_MODE=true
