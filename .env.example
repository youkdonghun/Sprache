# Flutter compile-time values
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_APPLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=
APP_ENV=development
ENABLE_MOCK_MODE=true
PRIVACY_POLICY_URL=https://youkdonghun.github.io/Sprache/privacy/

# Windows REAL builds read this only from the process environment.
# Keep the value blank in files and inject it through a local/CI secret store.
SPRACHE_GOOGLE_DESKTOP_CLIENT_SECRET=
